{% set gardenNotes = collections.note | gardenNotes %}
{% set gardenTopics = gardenNotes | gardenTopics %}
{% set gardenHubs = gardenNotes | gardenHubs %}
<section class="garden-home-entry">
  <p class="garden-home-kicker">Browse the garden</p>
  {% if gardenHubs.length %}
    <h2>Hubs</h2>
    <div class="garden-home-hubs">
      {% for hub in gardenHubs %}
        <a class="garden-hub-link" href="{{ hub.url }}">{{ hub.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <h2>Explore by Topic</h2>
  {% if gardenTopics.length %}
    <div class="garden-home-topics">
      {% for topic in gardenTopics %}
        <a class="garden-topic-chip" href="/garden/?topic={{ topic.value }}">{{ topic.label }}</a>
      {% endfor %}
    </div>
  {% else %}
    <p class="garden-home-empty">Add topics in Obsidian frontmatter to browse notes by topic.</p>
  {% endif %}
  <a class="garden-browse-link" href="/garden/">Browse all notes →</a>
</section>
